{
  "name": "@oversightstudio/blur-data-urls",
  "type": "module",
  "version": "1.0.4",
  "description": "Automatically assign URLs for blur data to media collections in Payload.",
  "private": false,
  "bugs": "https://github.com/oversightstudio/payload-plugins/issues",
  "repository": "https://github.com/oversightstudio/payload-plugins/tree/main/packages/blur-data-urls",
  "license": "MIT",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "author": "oversightstudio",
  "files": [
    "dist"
  ],
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "blur",
    "data",
    "urls"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "devDependencies": {
    "payload": "3.88.0",
    "sharp": "0.35.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "payload": ">=3.79.1 <4",
    "sharp": ">=0.34.2 <0.36"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://registry.npmjs.org/",
    "types": "./dist/index.d.ts"
  }
}
