{
  "name": "@oversightstudio/mux-video",
  "type": "module",
  "version": "1.4.1",
  "description": "Brings Mux Video to PayloadCMS.",
  "private": false,
  "bugs": "https://github.com/oversightstudio/payload-plugins/issues",
  "repository": "https://github.com/oversightstudio/payload-plugins/tree/main/packages/mux-video",
  "license": "MIT",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "author": "oversightstudio",
  "files": [
    "dist"
  ],
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "mux",
    "video",
    "upload"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./elements": {
      "import": "./src/fields/index.ts",
      "default": "./src/fields/index.ts"
    }
  },
  "devDependencies": {
    "@mux/mux-player-react": "3.13.2",
    "@payloadcms/ui": "3.88.0",
    "@types/react": "19.2.14",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@mux/mux-player-react": ">=3.4.1 <4",
    "@payloadcms/ui": ">=3.79.1 <4",
    "payload": ">=3.79.1 <4"
  },
  "dependencies": {
    "@mux/mux-node": "15.0.0",
    "@mux/mux-uploader-react": "1.5.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      },
      "./elements": {
        "import": "./dist/fields/index.js",
        "require": "./dist/fields/index.cjs",
        "types": "./dist/fields/index.d.ts"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://registry.npmjs.org/",
    "types": "./dist/index.d.ts"
  }
}
