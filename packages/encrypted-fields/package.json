{
  "name": "@oversightstudio/encrypted-fields",
  "type": "module",
  "version": "1.0.0",
  "description": "Database field encryption for Payload.",
  "private": false,
  "bugs": "https://github.com/oversightstudio/payload-plugins/issues",
  "repository": "https://github.com/oversightstudio/payload-plugins/tree/main/packages/encrypted-fields",
  "license": "MIT",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "author": "oversightstudio",
  "files": [
    "dist"
  ],
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "encrypted",
    "fields",
    "payloadcms"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@payloadcms/ui": "3.88.0",
    "payload": "3.88.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@payloadcms/ui": ">=3.79.1 <4",
    "payload": ">=3.79.1 <4"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://registry.npmjs.org/",
    "types": "./dist/index.d.ts"
  }
}
